# ==========================================
# VARIABLES D'ENVIRONNEMENT - TOP PICK
# ==========================================
# Instructions : Copiez le contenu de ce fichier, collez-le dans un nouveau fichier nommé ".env.local" 
# et remplissez-y vos vraies clés.
# ⚠️ NE PUSHEZ JAMAIS le fichier .env.local sur GitHub !

# 1. URL de votre projet Supabase (Utilisée par le Client et le Serveur)
# Se trouve dans Supabase : Project Settings -> API -> Project URL
NEXT_PUBLIC_SUPABASE_URL="https://votredomaine.supabase.co"

# 2. Clé "anon / public" (Utilisée publiquement dans le navigateur pour lire le catalogue, etc.)
# Se trouve dans Supabase : Project Settings -> API -> Project API Keys (anon public)
NEXT_PUBLIC_SUPABASE_ANON_KEY="votre_cle_anon_publique_ici"

# 3. Clé "service_role" (Secrète, utilisée UNIQUEMENT côté Serveur pour contourner la sécurité)
# Indispensable pour l'administration (lecture des commandes des clients protégées par la RLS).
# Se trouve dans Supabase : Project Settings -> API -> Project API Keys (service_role secret)
# ⚠️ NE JAMAIS METTRE LE PREFIXE 'NEXT_PUBLIC_' DEVANT CETTE CLÉ !
SUPABASE_SERVICE_ROLE_KEY="votre_cle_service_role_secrete_ici"
